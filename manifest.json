{
	"manifest_version": 3,
	"name": "__MSG_extName__",
	"version": "0.1.1",
	"description": "__MSG_extDescription__",
	"default_locale": "zh_TW",
	"homepage_url": "https://github.com/BoringMan314/bm-ani-gamer-get-cookie",
	"icons": {
		"128": "icons/icon.png"
	},
	"permissions": [
		"cookies",
		"tabs",
		"debugger"
	],
	"host_permissions": [
		"https://*.gamer.com.tw/*",
		"http://127.0.0.1/*"
	],
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"128": "icons/icon.png"
		},
		"default_title": "__MSG_extName__"
	}
}
